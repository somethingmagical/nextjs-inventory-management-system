generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum ProductTaxType {
  Exclusive
  Inclusive
}

enum ProductStockStatus {
  Received
  Pending
  Ordered
}

enum AdjustmentType {
  Addition
  Subtraction
}

enum PurchaseStatus {
  Pending
  Ordered
  Received
}

enum TransferStatus {
  Pending
  Sent
  Completed
}

enum PurchaseDiscountType {
  Fixed
  Percentage
}

enum SalePaymentStatus {
  Paid
  Unpaid
  Partial
}

enum StockMovementType {
  OpeningBalance
  ProductInitialization
  PurchaseReceipt
  PurchaseReturn
  Sale
  SaleReturn
  Adjustment
  Transfer
  Reconciliation
}

enum StockMovementSourceType {
  Product
  Purchase
  PurchaseReturn
  Sale
  SaleReturn
  Adjustment
  Transfer
}

model User {
  id             String          @id @default(cuid())
  firstName      String
  lastName       String
  email          String          @unique
  password       String
  phoneNumber    String?
  image          String?
  role           String          @default("user")
  roleId         String
  roleRecord     Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([roleId])
  @@index([deletedAt])
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  users       User[]
  permissions RolePermission[]

  @@index([deletedAt])
}

model RolePermission {
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([permission])
}

model ApplicationSetting {
  id          String   @id
  appName     String   @db.VarChar(100)
  faviconPath String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt
}

model Warehouse {
  id              String           @id @default(cuid())
  name            String
  email           String
  phoneNumber     String
  country         String
  city            String
  zipCode         String
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  saleReturns     SaleReturn[]
  productStocks   ProductStock[]
  stockMovements  StockMovement[]
  adjustments     Adjustment[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  sales           Sale[]
  transfersFrom   Transfer[]       @relation("TransferFromWarehouse")
  transfersTo     Transfer[]       @relation("TransferToWarehouse")
  expenses        Expense[]

  @@index([deletedAt])
}

model Supplier {
  id              String           @id @default(cuid())
  name            String
  email           String
  phoneNumber     String
  country         String
  city            String
  address         String
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  productStocks   ProductStock[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]

  @@index([deletedAt])
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  dateOfBirth DateTime?
  country     String
  city        String
  address     String
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  sales       Sale[]
  saleReturns SaleReturn[]

  @@index([deletedAt])
}

model Product {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  price               Decimal              @db.Decimal(12, 2)
  categoryId          String
  brandId             String
  productUnit         String
  stockAlert          Decimal?             @db.Decimal(12, 3)
  orderTax            Decimal?             @db.Decimal(5, 2)
  taxType             ProductTaxType       @default(Exclusive)
  quantityLimitation  Decimal?             @db.Decimal(12, 3)
  notes               String?              @db.Text
  images              Json?
  categoryRecord      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandRecord         Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  productStocks       ProductStock[]
  stockMovements      StockMovement[]
  adjustmentItems     AdjustmentItem[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  transferItems       TransferItem[]
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // Legacy columns remain during the staged migration so the current product screens stay usable.
  category      String?
  brand         String?
  unit          String  @default("piece")
  purchasePrice Decimal @default(0) @db.Decimal(12, 2)
  sellingPrice  Decimal @default(0) @db.Decimal(12, 2)
  alertQuantity Decimal @default(0) @db.Decimal(12, 3)
  image         String?
  description   String? @db.Text

  @@index([deletedAt])
  @@index([name])
  @@index([categoryId])
  @@index([brandId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([name, deletedAt])
  @@index([deletedAt])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([name, deletedAt])
  @@index([deletedAt])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@index([name, deletedAt])
  @@index([deletedAt])
}

model Expense {
  id                String          @id @default(cuid())
  reference         String          @unique
  date              DateTime        @db.Date
  title             String
  warehouseId       String
  expenseCategoryId String
  amount            Decimal         @db.Decimal(12, 2)
  details           String?         @db.Text
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  expenseCategory   ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: Restrict)

  @@index([warehouseId])
  @@index([expenseCategoryId])
  @@index([date])
  @@index([deletedAt])
}

model Unit {
  id        String    @id @default(cuid())
  name      String    @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model ProductStock {
  id          String             @id @default(cuid())
  productId   String
  warehouseId String
  supplierId  String?
  quantity    Decimal            @db.Decimal(12, 3)
  status      ProductStockStatus @default(Received)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplier    Supplier?          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([supplierId])
}

model StockMovement {
  id          String                   @id @default(cuid())
  productId   String
  warehouseId String
  quantity    Decimal                  @db.Decimal(12, 3)
  type        StockMovementType
  sourceType  StockMovementSourceType?
  sourceId    String?
  actorId     String?
  product     Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse                @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  actor       User?                    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt   DateTime                 @default(now())

  @@index([productId, warehouseId, createdAt])
  @@index([sourceType, sourceId])
  @@index([actorId])
}

model Adjustment {
  id          String           @id @default(cuid())
  reference   String           @unique
  warehouseId String
  date        DateTime         @db.Date
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items       AdjustmentItem[]
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([warehouseId])
  @@index([deletedAt])
}

model AdjustmentItem {
  id           String         @id @default(cuid())
  adjustmentId String
  productId    String
  quantity     Decimal        @db.Decimal(12, 3)
  type         AdjustmentType
  adjustment   Adjustment     @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([adjustmentId])
  @@index([productId])
}

model Purchase {
  id            String         @id @default(cuid())
  reference     String         @unique
  supplierId    String
  warehouseId   String
  date          DateTime       @db.Date
  status        PurchaseStatus @default(Received)
  orderTax      Decimal        @default(0) @db.Decimal(5, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  shipping      Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal        @default(0) @db.Decimal(12, 2)
  paymentType   String         @default("Cash")
  paymentStatus String         @default("Unpaid")
  notes         String?        @db.Text
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items         PurchaseItem[]
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([supplierId])
  @@index([warehouseId])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
}

model PurchaseItem {
  id           String               @id @default(cuid())
  purchaseId   String
  productId    String
  netUnitCost  Decimal              @db.Decimal(12, 2)
  quantity     Decimal              @db.Decimal(12, 3)
  unit         String
  discountType PurchaseDiscountType @default(Fixed)
  discount     Decimal              @default(0) @db.Decimal(12, 2)
  taxType      ProductTaxType       @default(Exclusive)
  orderTax     Decimal              @default(0) @db.Decimal(5, 2)
  subtotal     Decimal              @db.Decimal(12, 2)
  purchase     Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([purchaseId])
  @@index([productId])
}

model PurchaseReturn {
  id          String               @id @default(cuid())
  reference   String               @unique
  supplierId  String
  warehouseId String
  date        DateTime             @db.Date
  status      PurchaseStatus       @default(Received)
  orderTax    Decimal              @default(0) @db.Decimal(5, 2)
  discount    Decimal              @default(0) @db.Decimal(12, 2)
  shipping    Decimal              @default(0) @db.Decimal(12, 2)
  grandTotal  Decimal              @default(0) @db.Decimal(12, 2)
  paid        Decimal              @default(0) @db.Decimal(12, 2)
  due         Decimal              @default(0) @db.Decimal(12, 2)
  paymentType String               @default("Cash")
  notes       String?              @db.Text
  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items       PurchaseReturnItem[]
  deletedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([supplierId])
  @@index([warehouseId])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
}

model PurchaseReturnItem {
  id             String               @id @default(cuid())
  returnId       String
  productId      String
  netUnitCost    Decimal              @db.Decimal(12, 2)
  quantity       Decimal              @db.Decimal(12, 3)
  unit           String
  discountType   PurchaseDiscountType @default(Fixed)
  discount       Decimal              @default(0) @db.Decimal(12, 2)
  taxType        ProductTaxType       @default(Exclusive)
  orderTax       Decimal              @default(0) @db.Decimal(5, 2)
  subtotal       Decimal              @db.Decimal(12, 2)
  purchaseReturn PurchaseReturn       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([returnId])
  @@index([productId])
}

model Sale {
  id            String            @id @default(cuid())
  reference     String            @unique
  customerId    String
  warehouseId   String
  date          DateTime          @db.Date
  status        PurchaseStatus    @default(Received)
  orderTax      Decimal           @default(0) @db.Decimal(5, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  shipping      Decimal           @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal           @default(0) @db.Decimal(12, 2)
  paid          Decimal           @default(0) @db.Decimal(12, 2)
  due           Decimal           @default(0) @db.Decimal(12, 2)
  paymentStatus SalePaymentStatus @default(Unpaid)
  paymentType   String            @default("Cash")
  notes         String?           @db.Text
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items         SaleItem[]
  payments      SalePayment[]
  saleReturns   SaleReturn[]
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([customerId])
  @@index([warehouseId])
  @@index([date])
  @@index([status])
  @@index([paymentStatus])
  @@index([deletedAt])
}

model SaleItem {
  id           String               @id @default(cuid())
  saleId       String
  productId    String
  netUnitPrice Decimal              @db.Decimal(12, 2)
  quantity     Decimal              @db.Decimal(12, 3)
  unit         String
  discountType PurchaseDiscountType @default(Fixed)
  discount     Decimal              @default(0) @db.Decimal(12, 2)
  taxType      ProductTaxType       @default(Exclusive)
  orderTax     Decimal              @default(0) @db.Decimal(5, 2)
  subtotal     Decimal              @db.Decimal(12, 2)
  sale         Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id          String   @id @default(cuid())
  saleId      String
  amount      Decimal  @db.Decimal(12, 2)
  paymentType String
  date        DateTime @db.Date
  notes       String?  @db.Text
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([saleId])
  @@index([date])
}

model SaleReturn {
  id            String            @id @default(cuid())
  reference     String            @unique
  customerId    String
  warehouseId   String
  saleId        String?
  date          DateTime          @db.Date
  status        PurchaseStatus    @default(Received)
  orderTax      Decimal           @default(0) @db.Decimal(5, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  shipping      Decimal           @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal           @default(0) @db.Decimal(12, 2)
  paid          Decimal           @default(0) @db.Decimal(12, 2)
  due           Decimal           @default(0) @db.Decimal(12, 2)
  paymentStatus SalePaymentStatus @default(Unpaid)
  notes         String?           @db.Text
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  sale          Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  items         SaleReturnItem[]
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([customerId])
  @@index([warehouseId])
  @@index([saleId])
  @@index([date])
  @@index([status])
  @@index([paymentStatus])
  @@index([deletedAt])
}

model SaleReturnItem {
  id           String               @id @default(cuid())
  returnId     String
  productId    String
  netUnitPrice Decimal              @db.Decimal(12, 2)
  quantity     Decimal              @db.Decimal(12, 3)
  unit         String
  discountType PurchaseDiscountType @default(Fixed)
  discount     Decimal              @default(0) @db.Decimal(12, 2)
  taxType      ProductTaxType       @default(Exclusive)
  orderTax     Decimal              @default(0) @db.Decimal(5, 2)
  subtotal     Decimal              @db.Decimal(12, 2)
  saleReturn   SaleReturn           @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([returnId])
  @@index([productId])
}

model Transfer {
  id              String         @id @default(cuid())
  reference       String         @unique
  fromWarehouseId String
  toWarehouseId   String
  date            DateTime       @db.Date
  status          TransferStatus @default(Pending)
  orderTax        Decimal        @default(0) @db.Decimal(5, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  shipping        Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal        @default(0) @db.Decimal(12, 2)
  notes           String?        @db.Text
  fromWarehouse   Warehouse      @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse     Warehouse      @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  items           TransferItem[]
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([date])
  @@index([status])
  @@index([deletedAt])
}

model TransferItem {
  id           String               @id @default(cuid())
  transferId   String
  productId    String
  netUnitCost  Decimal              @db.Decimal(12, 2)
  quantity     Decimal              @db.Decimal(12, 3)
  discountType PurchaseDiscountType @default(Fixed)
  discount     Decimal              @default(0) @db.Decimal(12, 2)
  taxType      ProductTaxType       @default(Exclusive)
  orderTax     Decimal              @default(0) @db.Decimal(5, 2)
  subtotal     Decimal              @db.Decimal(12, 2)
  transfer     Transfer             @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([transferId])
  @@index([productId])
}
