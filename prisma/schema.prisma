generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum ProductTaxType {
  Exclusive
  Inclusive
}

enum ProductStockStatus {
  Received
  Pending
  Ordered
}

model User {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String    @unique
  password    String
  phoneNumber String?
  image       String?
  role        String    @default("user")
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

model Role {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model Warehouse {
  id            String         @id @default(cuid())
  name          String
  email         String
  phoneNumber   String
  country       String
  city          String
  zipCode       String
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  productStocks ProductStock[]

  @@index([deletedAt])
}

model Supplier {
  id            String         @id @default(cuid())
  name          String
  email         String
  phoneNumber   String
  country       String
  city          String
  address       String
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  productStocks ProductStock[]

  @@index([deletedAt])
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  dateOfBirth DateTime?
  country     String
  city        String
  address     String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

model Product {
  id                 String         @id @default(cuid())
  code               String         @unique
  name               String
  price              Decimal        @db.Decimal(12, 2)
  categoryId         String
  brandId            String
  productUnit        String
  stockAlert         Decimal?       @db.Decimal(12, 3)
  orderTax           Decimal?       @db.Decimal(5, 2)
  taxType            ProductTaxType @default(Exclusive)
  quantityLimitation Decimal?       @db.Decimal(12, 3)
  notes              String?        @db.Text
  images             Json?
  categoryRecord     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandRecord        Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  productStocks      ProductStock[]
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Legacy columns remain during the staged migration so the current product screens stay usable.
  category      String?
  brand         String?
  unit          String  @default("piece")
  purchasePrice Decimal @default(0) @db.Decimal(12, 2)
  sellingPrice  Decimal @default(0) @db.Decimal(12, 2)
  alertQuantity Decimal @default(0) @db.Decimal(12, 3)
  image         String?
  description   String? @db.Text

  @@index([deletedAt])
  @@index([name])
  @@index([categoryId])
  @@index([brandId])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([name, deletedAt])
  @@index([deletedAt])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([name, deletedAt])
  @@index([deletedAt])
}

model Unit {
  id        String    @id @default(cuid())
  name      String    @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model ProductStock {
  id          String             @id @default(cuid())
  productId   String
  warehouseId String
  supplierId  String
  quantity    Decimal            @db.Decimal(12, 3)
  status      ProductStockStatus @default(Received)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  supplier    Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([supplierId])
}
